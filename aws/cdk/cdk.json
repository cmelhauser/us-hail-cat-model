{
  "app": "python3 app.py",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README*",
      "cdk*.json",
      "requirements*.txt",
      "source.bat",
      "**/__pycache__",
      "**/*.pyc"
    ]
  },
  "context": {
    "@aws-cdk/aws-ecs:arnFormatIncludesClusterName": true,
    "@aws-cdk/aws-ec2:uniqueImdsv2TemplateName": true
  }
}
